# ── crude-alpha-stream environment ───────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).

# ── Databento (REQUIRED) ──────────────────────────────────────────────────────
# Live GLBX.MDP3 entitlement key. The sidecar aborts without it.
DATABENTO_API_KEY=db-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ATM strikes per side to subscribe on the LO option chain (±N at $0.50 steps).
STRIKES_WINDOW=40

# ── Stream / public ingress ───────────────────────────────────────────────────
# Host port to publish the WS stream on (container always listens on 7070).
STREAM_PORT=7070
# Snapshot emit cadence (ms).
SIDECAR_EMIT_MS=1000

# ── Payment: Tempo MPP (the ONLY rail) ────────────────────────────────────────
# Network toggle — the single switch between mainnet and testnet:
#   false (default) = Tempo MAINNET  (chain 4217, rpc.tempo.xyz,  pathUSD 0x20C0…E8b50)
#   true            = Tempo testnet  (chain 42431, rpc.moderato…, pathUSD 0x20c0…0000, open faucet)
MPP_TESTNET=false

# Recipient signing key — receives payments AND pays settle/close gas (in
# stablecoin). On MAINNET this wallet must hold real pathUSD. Without it the
# /mpp/session route is disabled and the stream serves no paid data. SECRET.
MPP_RECIPIENT_KEY=0xYOUR_RECIPIENT_PRIVATE_KEY

# HMAC secret that signs stream-access tokens (binds an MPP payment → WS access).
# Use a long random value in production. SECRET.
MPP_SECRET_KEY=change-me-to-a-long-random-string

# Minutes of stream access granted per paid voucher. Price is $0.001/min.
MPP_MINUTES_PER_PAYMENT=1
# pathUSD charged per voucher (defaults to the per-minute price).
MPP_AMOUNT=0.001

# Optional explicit overrides (else derived from MPP_TESTNET):
# MPP_RPC=https://rpc.tempo.xyz
# MPP_CHAIN_ID=4217
# MPP_CURRENCY=0x20C000000000000000000000b9537d11c60E8b50
